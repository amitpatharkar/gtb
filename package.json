{
  "name": "gtb",
  "version": "1.0.0",
  "description": "Bombay Bawaal (code name GTB): a fun, toned-down open-world browser game set in the real Mumbai",
  "scripts": {
    "tiles": "node scripts/build-tiles.mjs",
    "tiles:preview": "node scripts/preview-tiles.mjs",
    "assets": "node scripts/assets/build-assets.mjs",
    "assets:pull": "git fetch -q --depth 1 origin assets && rm -rf public/media && mkdir -p public/media && git archive FETCH_HEAD | tar -x -C public/media",
    "predev": "npm run tiles && node scripts/art-index.mjs",
    "dev": "vite --host",
    "build": "npm run tiles && node scripts/art-index.mjs && vite build",
    "preview": "vite preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitpatharkar/gtb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amitpatharkar/gtb/issues"
  },
  "homepage": "https://github.com/amitpatharkar/gtb#readme",
  "dependencies": {
    "earcut": "^3.0.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.2",
    "ktx2-encoder": "^0.6.0",
    "lineclip": "^2.0.0",
    "pbf": "^5.1.2",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module"
}
